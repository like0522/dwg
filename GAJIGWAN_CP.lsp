        (2833.6272 4053.0716) (2833.1295 4054.1070) (2832.6429 4055.1477) (2832.1671 4056.1933) (2831.7019 4057.2437)
        (2831.2469 4058.2986) (2830.8019 4059.3577) (2830.3665 4060.4208) (2829.9406 4061.4877) (2829.5239 4062.5583)
        (2829.1161 4063.6323) (2828.7171 4064.7096) (2828.3266 4065.7900) (2827.9444 4066.8734) (2827.5703 4067.9595)
        (2827.2041 4069.0484) (2826.8456 4070.1399) (2826.4946 4071.2338) (2826.1510 4072.3300) (2825.8146 4073.4284)
        (2825.4853 4074.5290) (2825.1628 4075.6316) (2824.8471 4076.7362) (2824.5379 4077.8426) (2824.2352 4078.9508)
        (2823.9389 4080.0607) (2823.6487 4081.1723) (2823.3646 4082.2854) (2823.0864 4083.4001) (2822.8141 4084.5161)
        (2822.5475 4085.6336) (2822.2866 4086.7523) (2822.0311 4087.8724) (2821.7811 4088.9937) (2821.5364 4090.1161)
    )
    1
    '(254 1 1)
  )


  ;; 4. LEFT ZONE: 1:1 BENDING SHOP DRAWING
  (setq cxB (/ (+ bx splitX) 2.0))
  (setq cyB (+ by (* 1700.0 formScale) (* 0.5 (- rM hDist))))

  (gj-add-text "벤딩 제작도 (BENDING VIEW, SCALE 1:1)"
               (+ bx (* 100.0 formScale)) (+ by (* 3250.0 formScale)) (* 45.0 formScale) 0.75 0.0 3 "0")
  (gj-add-text (strcat "OD %%C" (rtos dBranch 2 1) " x " (rtos thk 2 1) "t (MAIN %%C" (rtos dMain 2 1) ")")
               (+ bx (* 100.0 formScale)) (+ by (* 3180.0 formScale)) (* 35.0 formScale) 0.75 0.0 7 "0")

  ;; Main Pipe Reference Circle (1:1)
  (gj-add-circle (list cxB cyB) rM "PL" 256)
  ;; Centerlines
  (gj-add-line (list (- cxB (+ rM 100.0)) cyB) (list (+ cxB (+ rM 100.0)) cyB) "CL" 256)
  (gj-add-line (list cxB (+ cyB (+ rM 100.0))) (list cxB (- cyB (+ hDist 100.0))) "CL" 256)

  ;; Branch Outer Walls, Bottom End, Inner Hidden Walls, and Saddle Arc (1:1)
  (gj-add-line (list (- cxB rBo) (- cyB hDist)) (list (+ cxB rBo) (- cyB hDist)) "0" 256)
  (gj-add-line (list (- cxB rBo) (- cyB hDist)) (list (- cxB rBo) (- cyB yInt)) "0" 256)
  (gj-add-line (list (+ cxB rBo) (- cyB hDist)) (list (+ cxB rBo) (- cyB yInt)) "0" 256)
  (gj-add-line (list (- cxB rBo) (- cyB yInt)) (list (- cxB rBi) (- cyB yInt)) "0" 256)
  (gj-add-line (list (+ cxB rBo) (- cyB yInt)) (list (+ cxB rBi) (- cyB yInt)) "0" 256)
  (gj-add-line (list (- cxB rBi) (- cyB hDist)) (list (- cxB rBi) (- cyB yInt)) "HL" 256)
  (gj-add-line (list (+ cxB rBi) (- cyB hDist)) (list (+ cxB rBi) (- cyB yInt)) "HL" 256)
  (gj-add-arc (list cxB cyB) rM (+ pi (atan yInt rBi)) (- (* 2.0 pi) (atan yInt rBi)) "0" 256)

  ;; Native Dimensions on DIMENSIONS layer (1:1 with DIMSCALE = 10 * formScale)
  (setvar "CLAYER" "DIMENSIONS")
  (gj-cmd-dim (list (- cxB rM) cyB) (list (+ cxB rM) cyB) (list cxB (+ cyB rM (* 18.0 dimScale))) (strcat "%%C" (rtos dMain 2 1)))
  (gj-cmd-dim (list (- cxB rBo) (- cyB hDist)) (list (+ cxB rBo) (- cyB hDist)) (list cxB (- cyB hDist (* 20.0 dimScale))) (strcat "%%C" (rtos dBranch 2 1)))
  (gj-cmd-dim (list (+ cxB rBo) cyB) (list (+ cxB rBo) (- cyB hDist)) (list (+ cxB rM (* 25.0 dimScale)) (- cyB (* 0.5 hDist))) "")
  (gj-cmd-dim (list (+ cxB rBo) (- cyB yInt)) (list (+ cxB rBo) (- cyB hDist)) (list (+ cxB rBo (* 14.0 dimScale)) (- cyB (* 0.5 (+ yInt hDist)))) "")
  (gj-cmd-dim (list cxB (- cyB rM)) (list cxB (- cyB hDist)) (list (- cxB rBo (* 14.0 dimScale)) (- cyB (* 0.5 (+ rM hDist)))) "")
  (setvar "CLAYER" "0")

  ;; 5. RIGHT ZONE: 1:1 CUTTING FLAT PATTERN (N-piece split + Seam Angle)
  (setq oxD (+ splitX (/ (- (+ bx formW) splitX pieceW) 2.0)))
  (setq oyD (+ by (- (* 3050.0 formScale) totalDevH)))
  (if (< oyD (+ by 350.0)) (setq oyD (+ by 350.0)))

  (gj-add-text (strcat "절단 전개도 (SCALE 1:1, 분할위치 " (rtos seamDeg 2 1) "도)")
               (+ splitX (* 100.0 formScale)) (+ by (* 3250.0 formScale)) (* 45.0 formScale) 0.75 0.0 3 "0")
  (gj-add-text (strcat "PLATE: " (rtos thk 2 1) "t x " (rtos pieceW 2 1) " x " (rtos lMax 2 1) " (1EA/SET)")
               (+ splitX (* 100.0 formScale)) (+ by (* 3180.0 formScale)) (* 35.0 formScale) 0.75 0.0 7 "0")

  ;; Curve segment count: user-specified (>=16) or auto (~12mm chord, multiple of 4)
  (if (and segCountIn (>= segCountIn 16))
    (setq nSegPiece segCountIn)
    (if (= nParts 1)
      (setq nSegPiece (max 72 (* 4 (fix (+ (/ pieceW 48.0) 0.9999)))))
      (setq nSegPiece (max 18 (fix (+ (/ pieceW 12.0) 0.9999))))
    )
  )

  (setq k 0)
  (while (< k nParts)
    (setq oyK (+ oyD (* (- nParts 1 k) gapY)))
    (setq ptsDev nil)
    (setq hPeak 0.0)
    (setq i 0)
    (while (<= i nSegPiece)
      (setq theta (+ (/ pi 2.0) seamRad (/ (* 2.0 pi (+ k (/ (float i) nSegPiece))) (float nParts))))
      (setq sVal (/ (* pieceW i) (float nSegPiece)))
      (setq xLoc (* rBi (cos theta)))
      (setq ySaddle (sqrt (- (* rM rM) (* xLoc xLoc))))
      (setq hVal (- hDist ySaddle))
      (if (= i 0) (setq hStart hVal))
      (if (= i nSegPiece) (setq hEnd hVal))
      (if (> hVal hPeak) (setq hPeak hVal))
      (setq ptsDev (append ptsDev (list (list (+ oxD sVal) (+ oyK hVal)))))
      (setq i (1+ i))
    )
    (setq ptsDev (append ptsDev (list (list (+ oxD pieceW) oyK) (list oxD oyK))))
    (gj-add-pline ptsDev T "0" 256)

    (if (> nParts 1)
      (gj-add-text (strcat "PART #" (itoa (1+ k)) "/" (itoa nParts) " (" (rtos pieceW 2 1) " x " (rtos hPeak 2 1) ")")
                   oxD (+ oyK hPeak (* 6.0 dimScale)) (* 30.0 formScale) 0.75 0.0 3 "0")
      (foreach q '(0.0 0.25 0.5 0.75)
        (setq uRaw (- q (/ (float seamDeg) 360.0)))
        (setq uFrac (- uRaw (fix (if (< uRaw 0.0) (- uRaw 0.999999) uRaw))))
        (while (< uFrac 0.0) (setq uFrac (+ uFrac 1.0)))
        (while (>= uFrac 1.0) (setq uFrac (- uFrac 1.0)))
        (if (and (> uFrac 0.001) (< uFrac 0.999))
          (gj-add-line (list (+ oxD (* pieceW uFrac)) (- oyK 60.0))
                       (list (+ oxD (* pieceW uFrac)) (+ oyK hPeak 60.0)) "CL" 256)
        )
      )
    )

    ;; Native Dimensions on each flat pattern piece
    (setvar "CLAYER" "DIMENSIONS")
    (gj-cmd-dim (list oxD oyK) (list (+ oxD pieceW) oyK) (list (+ oxD (* 0.5 pieceW)) (- oyK (* 14.0 dimScale))) "")
    (gj-cmd-dim (list oxD oyK) (list oxD (+ oyK hStart)) (list (- oxD (* 12.0 dimScale)) (+ oyK (* 0.5 hStart))) "")
    (gj-cmd-dim (list (+ oxD pieceW) oyK) (list (+ oxD pieceW) (+ oyK hEnd)) (list (+ oxD pieceW (* 12.0 dimScale)) (+ oyK (* 0.5 hEnd))) "")
    (setvar "CLAYER" "0")

    (setq k (1+ k))
  )

  ;; Restore system variables
  (setvar "OSMODE" oldOsm)
  (setvar "CMDECHO" oldEcho)
  (setvar "CLAYER" oldLyr)
  (setvar "DIMSCALE" oldDimScale)
  (if doc (vla-EndUndoMark doc) (command "_.UNDO" "_End"))

  (princ (strcat "\n[GAJIGWAN] Completed 1:1! FormScale=" (rtos formScale 2 2) "x, DIMSCALE=" (rtos dimScale 2 1) ", Parts=" (itoa nParts) ", Seam=" (rtos seamDeg 2 0) "deg, PieceW=" (rtos pieceW 2 2) ", L_min=" (rtos lMin 2 2) ", L_max=" (rtos lMax 2 2)))
  (princ)
)

;;; Helper: Write temporary DCL file for branch pipe input dialog
(defun gj-write-dcl ( / dclPath f )
  (setq dclPath (strcat (getvar "TEMPPREFIX") "gajigwan_dlg.dcl"))
  (setq f (open dclPath "w"))
  (if f
    (progn
      (foreach ln
        '(
          "gajigwan_dlg : dialog {"
          "  label = \"두신이엔지 가지관 단품가공도 & 전개도 생성기 (v1.6)\";"
          "  : boxed_column {"
          "    label = \"표제란 정보 (Title Block)\";"
          "    : edit_box { key = \"cust\"; label = \"CUSTOMER:\"; edit_width = 26; }"
          "    : edit_box { key = \"proj\"; label = \"PROJECT:\"; edit_width = 26; }"
          "    : edit_box { key = \"dwgno\"; label = \"DWG NO.:\"; edit_width = 26; }"
          "    : row {"
          "      : edit_box { key = \"page\"; label = \"페이지 (NO.):\"; edit_width = 8; }"
          "      : edit_box { key = \"qty\"; label = \"수량 (EA):\"; edit_width = 8; }"
          "    }"
          "  }"
          "  : boxed_column {"
          "    label = \"가지관 치수 입력 (mm)\";"
          "    : edit_box { key = \"dMain\"; label = \"메인관 외경 (Main OD):\"; edit_width = 14; }"
          "    : edit_box { key = \"dBranch\"; label = \"가지관 외경 (Branch OD):\"; edit_width = 14; }"
          "    : edit_box { key = \"thk\"; label = \"가지관 두께 (t):\"; edit_width = 14; }"
          "    : edit_box { key = \"hDist\"; label = \"메인관 중심 ~ 끝단 거리 (H):\"; edit_width = 14; }"
          "  }"
          "  : boxed_column {"
          "    label = \"분할 각도 / 곡선 세그먼트 / 양식 설정\";"
          "    : row {"
          "      : edit_box { key = \"seamDeg\"; label = \"분할 각도 (0,22.5,45,90):\"; edit_width = 8; }"
          "      : edit_box { key = \"fscale\"; label = \"양식배율 (0=자동):\"; edit_width = 6; }"
          "    }"
          "    : edit_box { key = \"segCnt\"; label = \"곡선 세그먼트 수 (0=자동 ~12mm):\"; edit_width = 10; }"
          "    : text { key = \"recGuide\"; label = \"Ø별 추천(12mm): Ø300=80 | Ø500=132 | Ø800=208 | Ø1000=260 | Ø1200=312 | Ø1500=392\"; }"
          "  }"
          "  : text { key = \"err\"; label = \"\"; }"
          "  ok_cancel;"
          "}"
        )
        (write-line ln f)
      )
      (close f)
    )
  )
  dclPath
)

;;; Helper: Update live recommended segment count in DCL
(defun gj-update-rec ( / bVal tVal wTmp recN stepMm )
  (setq bVal (atof (get_tile "dBranch")))
  (setq tVal (atof (get_tile "thk")))
  (if (> bVal tVal)
    (progn
      (setq wTmp (* pi (- bVal tVal)))
      (setq recN (max 72 (* 4 (fix (+ (/ wTmp 48.0) 0.9999)))))
      (setq stepMm (/ wTmp (float recN)))
      (set_tile "err" (strcat "현재 Ø" (rtos bVal 2 1) " 추천 세그먼트: " (itoa recN) "개 (약 " (rtos stepMm 2 1) "mm 간격)"))
    )
  )
)

;;; Interactive Command (DCL Dialog): GAJIGWAN
(defun c:GAJIGWAN ( / dclPath dclId res pt
                      vCust vProj vDwg vPage vQty vMain vBranch vThk vH vSeam vFscale vSeg
                      qInt mVal bVal tVal hVal seamVal fVal segInt )
  ;; Initialize persistent defaults
  (if (null *gj-last-cust*) (setq *gj-last-cust* "일광메탈포밍"))
  (if (null *gj-last-proj*) (setq *gj-last-proj* "--"))
  (if (null *gj-last-dwg*) (setq *gj-last-dwg* "COC-COC-88006007"))
  (if (null *gj-last-page*) (setq *gj-last-page* "1"))
  (if (null *gj-last-qty*) (setq *gj-last-qty* "1"))
  (if (null *gj-last-main*) (setq *gj-last-main* "1526.0"))
  (if (null *gj-last-branch*) (setq *gj-last-branch* "1219.2"))
  (if (null *gj-last-thk*) (setq *gj-last-thk* "9.0"))
  (if (null *gj-last-h*) (setq *gj-last-h* "985.0"))
  (if (null *gj-last-seam*) (setq *gj-last-seam* "0"))
  (if (null *gj-last-fscale*) (setq *gj-last-fscale* "0"))
  (if (null *gj-last-seg*) (setq *gj-last-seg* "0"))

  (setq dclPath (gj-write-dcl))
  (setq dclId (load_dialog dclPath))
  (if (or (null dclId) (< dclId 0))
    (progn
      (princ "\n[ERROR] Failed to load DCL dialog. Running CLI fallback...")
      (c:GAJIGWAN_CLI)
    )
    (progn
      (if (not (new_dialog "gajigwan_dlg" dclId))
        (progn
          (unload_dialog dclId)
          (princ "\n[ERROR] Failed to initialize dialog.")
        )
        (progn
          (set_tile "cust" *gj-last-cust*)
          (set_tile "proj" *gj-last-proj*)
          (set_tile "dwgno" *gj-last-dwg*)
          (set_tile "page" *gj-last-page*)
          (set_tile "qty" *gj-last-qty*)
          (set_tile "dMain" *gj-last-main*)
          (set_tile "dBranch" *gj-last-branch*)
          (set_tile "thk" *gj-last-thk*)
          (set_tile "hDist" *gj-last-h*)
          (set_tile "seamDeg" *gj-last-seam*)
          (set_tile "fscale" *gj-last-fscale*)
          (set_tile "segCnt" *gj-last-seg*)
          (gj-update-rec)

          (action_tile "dBranch" "(gj-update-rec)")
          (action_tile "thk" "(gj-update-rec)")

          (action_tile "accept"
            (strcat
              "(setq vCust (get_tile \"cust\"))"
              "(setq vProj (get_tile \"proj\"))"
              "(setq vDwg (get_tile \"dwgno\"))"
              "(setq vPage (get_tile \"page\"))"
              "(setq vQty (get_tile \"qty\"))"
              "(setq vMain (get_tile \"dMain\"))"
              "(setq vBranch (get_tile \"dBranch\"))"
              "(setq vThk (get_tile \"thk\"))"
              "(setq vH (get_tile \"hDist\"))"
              "(setq vSeam (get_tile \"seamDeg\"))"
              "(setq vFscale (get_tile \"fscale\"))"
              "(setq vSeg (get_tile \"segCnt\"))"
              "(setq qInt (atoi vQty) mVal (atof vMain) bVal (atof vBranch) tVal (atof vThk) hVal (atof vH) seamVal (atof vSeam) fVal (atof vFscale) segInt (atoi vSeg))"
              "(cond"
              "  ((< qInt 1) (set_tile \"err\" \"[오류] 수량은 1 이상이어야 합니다.\"))"
              "  ((or (<= mVal 0.0) (<= bVal 0.0) (<= tVal 0.0) (<= hVal 0.0)) (set_tile \"err\" \"[오류] 모든 치수는 0보다 커야 합니다.\"))"
              "  ((>= bVal mVal) (set_tile \"err\" \"[오류] 가지관 외경은 메인관 외경보다 작아야 합니다.\"))"
              "  ((>= (* 2.0 tVal) bVal) (set_tile \"err\" \"[오류] 두께(t)가 가지관 반지름 이상입니다.\"))"
              "  ((<= hVal (/ mVal 2.0)) (set_tile \"err\" \"[오류] 거리 H는 메인관 반지름보다 커야 합니다.\"))"
              "  ((< fVal 0.0) (set_tile \"err\" \"[오류] 양식 배율은 0(자동) 이상이어야 합니다.\"))"
              "  ((and (/= segInt 0) (< segInt 16)) (set_tile \"err\" \"[오류] 세그먼트 수는 0(자동) 또는 16 이상이어야 합니다.\"))"
              "  (T (done_dialog 1))"
              ")"
            )
          )
          (action_tile "cancel" "(done_dialog 0)")

          (setq res (start_dialog))
          (unload_dialog dclId)

          (if (= res 1)
            (progn
              (setq *gj-last-cust* (if (= vCust "") "일광메탈포밍" vCust))
              (setq *gj-last-proj* (if (= vProj "") "--" vProj))
              (setq *gj-last-dwg* (if (= vDwg "") "COC-COC-88006007" vDwg))
              (setq *gj-last-page* (if (= vPage "") "1" vPage))
              (setq *gj-last-qty* vQty)
              (setq *gj-last-main* vMain)
              (setq *gj-last-branch* vBranch)
              (setq *gj-last-thk* vThk)
              (setq *gj-last-h* vH)
              (setq *gj-last-seam* vSeam)
              (setq *gj-last-fscale* vFscale)
              (setq *gj-last-seg* vSeg)

              (setq pt (getpoint "\n두신이엔지 가지관 단품도 배치 기준점(좌하단) 클릭 [기본 0,0]: "))
              (if (null pt) (setq pt (list 0.0 0.0 0.0)))
              (draw-gajigwan-cp pt *gj-last-cust* *gj-last-proj* *gj-last-dwg* *gj-last-page* qInt mVal bVal tVal hVal seamVal 1 fVal segInt)
            )
            (princ "\n[GAJIGWAN] Cancelled by user.")
          )
        )
      )
    )
  )
  (princ)
)

;;; Command-Line Fallback: GAJIGWAN_CLI
(defun c:GAJIGWAN_CLI ( / pt cust proj dwgno pageStr qty dMain dBranch thk hDist tmp )
  (setq pt (getpoint "\n두신이엔지 가지관 단품도 배치 기준점(좌하단) 클릭 [기본 0,0]: "))
  (if (null pt) (setq pt (list 0.0 0.0 0.0)))

  (setq cust (getstring T "\nCUSTOMER 입력 [기본 일광메탈포밍]: "))
  (if (= cust "") (setq cust "일광메탈포밍"))

  (setq proj (getstring T "\nPROJECT 입력 [기본 --]: "))
  (if (= proj "") (setq proj "--"))

  (setq dwgno (getstring T "\nDWG NO. 입력 [기본 COC-COC-88006007]: "))
  (if (= dwgno "") (setq dwgno "COC-COC-88006007"))

  (setq pageStr (getstring T "\n페이지 번호 입력 [기본 1]: "))
  (if (= pageStr "") (setq pageStr "1"))

  (setq tmp (getint "\n수량 입력 [기본 1]: "))
  (setq qty (if tmp tmp 1))

  (setq tmp (getreal "\n메인관 외경 입력 (mm) [기본 1526.0]: "))
  (setq dMain (if tmp tmp 1526.0))

  (setq tmp (getreal "\n가지관 외경 입력 (mm) [기본 1219.2]: "))
  (setq dBranch (if tmp tmp 1219.2))

  (setq tmp (getreal "\n가지관 두께 t 입력 (mm) [기본 9.0]: "))
  (setq thk (if tmp tmp 9.0))

  (setq tmp (getreal "\n메인관 중심~가지관 끝단 거리 H 입력 (mm) [기본 985.0]: "))
  (setq hDist (if tmp tmp 985.0))

  (draw-gajigwan-cp pt cust proj dwgno pageStr qty dMain dBranch thk hDist 0.0 1 0.0 0)
  (princ)
)

