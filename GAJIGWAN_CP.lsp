;;; Helper: Format today's date from CDATE as YYYY.MM.DD(DOW)
(defun gj-today-str ( / cdate y m d dowNames a y2 m2 dow )
  (setq cdate (rtos (getvar "CDATE") 2 0))
  (setq y (atoi (substr cdate 1 4)))
  (setq m (atoi (substr cdate 5 2)))
  (setq d (atoi (substr cdate 7 2)))
  ;; Zeller's congruence for day of week (0=Sun .. 6=Sat)
  (setq a (/ (- 14 m) 12))
  (setq y2 (- y a))
  (setq m2 (+ m (* 12 a) -2))
  (setq dow (rem (+ d y2 (/ y2 4) (- (/ y2 100)) (/ y2 400) (/ (* 31 m2) 12)) 7))
  (setq dowNames '("일" "월" "화" "수" "목" "금" "토"))
  (strcat
    (substr cdate 1 4) "." (substr cdate 5 2) "." (substr cdate 7 2)
    "(" (nth dow dowNames) ")"
  )
)

;;; Helper: Create or ensure layer exists using pure entmake
(defun gj-ensure-layer ( lName lColor )
  (if (null (tblsearch "LAYER" lName))
    (entmake
      (list
        '(0 . "LAYER")
        '(100 . "AcDbSymbolTableRecord")
        '(100 . "AcDbLayerTableRecord")
        (cons 2 lName)
        '(70 . 0)
        (cons 62 lColor)
        '(6 . "Continuous")
      )
    )
  )
)

;;; Helper: Draw LINE entity
(defun gj-add-line ( p1 p2 lyr col )
  (entmake
    (list
      '(0 . "LINE")
      (cons 8 lyr)
      (cons 62 col)
      (cons 10 (list (car p1) (cadr p1) 0.0))
      (cons 11 (list (car p2) (cadr p2) 0.0))
    )
  )
)

;;; Helper: Draw CIRCLE entity
(defun gj-add-circle ( cen rad lyr col )
  (entmake
    (list
      '(0 . "CIRCLE")
      (cons 8 lyr)
      (cons 62 col)
      (cons 10 (list (car cen) (cadr cen) 0.0))
      (cons 40 rad)
    )
  )
)

;;; Helper: Draw ARC entity (angles in radians)
(defun gj-add-arc ( cen rad ang1 ang2 lyr col )
  (entmake
    (list
      '(0 . "ARC")
      (cons 8 lyr)
      (cons 62 col)
      (cons 10 (list (car cen) (cadr cen) 0.0))
      (cons 40 rad)
      (cons 50 ang1)
      (cons 51 ang2)
    )
  )
)

;;; Helper: Draw TEXT entity
(defun gj-add-text ( str px py h sc ob col lyr )
  (entmake
    (list
      '(0 . "TEXT")
      (cons 8 lyr)
      (cons 62 col)
      (cons 10 (list px py 0.0))
      (cons 40 h)
      (cons 1 str)
      (cons 41 sc)
      (cons 51 ob)
      '(7 . "Standard")
      '(72 . 0)
      '(73 . 0)
    )
  )
)

;;; Helper: Draw closed or open LWPOLYLINE from 2D point list
(defun gj-add-pline ( pts closedFlag lyr col )
  (entmakex
    (append
      (list
        '(0 . "LWPOLYLINE")
        '(100 . "AcDbEntity")
        (cons 8 lyr)
        (cons 62 col)
        '(100 . "AcDbPolyline")
        (cons 90 (length pts))
        (cons 70 (if closedFlag 1 0))
      )
      (mapcar '(lambda (p) (cons 10 (list (car p) (cadr p)))) pts)
    )
  )
)

;;; Helper: Draw native AutoCAD Linear Dimension using current DIMSCALE
(defun gj-cmd-dim ( p1 p2 pText txtOverride / )
  (if (and txtOverride (/= txtOverride ""))
    (command "_.DIMLINEAR" "_non" (list (car p1) (cadr p1) 0.0)
                           "_non" (list (car p2) (cadr p2) 0.0)
                           "_T" txtOverride
                           "_non" (list (car pText) (cadr pText) 0.0))
    (command "_.DIMLINEAR" "_non" (list (car p1) (cadr p1) 0.0)
                           "_non" (list (car p2) (cadr p2) 0.0)
                           "_non" (list (car pText) (cadr pText) 0.0))
  )
)

;;; Core Generator Function (Callable both interactively and via COM)
(defun draw-gajigwan-cp ( pt cust proj dwgno pageStr qty dMain dBranch thk hDist seamDeg nParts formScaleIn segCountIn
                          / acadObj doc sp bx by oldOsm oldEcho oldLyr oldDimScale
                            rM rBo rBi wDev yInt lMin lMax
                            pieceW seamRad totalDevH gapY nSegPiece
                            splitRatio needLW needLH needRW needRH reqScale formScale formW formH splitX dimScale
                            cxB cyB oxD oyD k i theta0 theta sVal xLoc ySaddle hVal hStart hEnd hPeak ptsDev
                            uRaw uFrac make-hatch-loop todayStr bomStr )

  (defun *error* ( msg )
    (if oldOsm (setvar "OSMODE" oldOsm))
    (if oldEcho (setvar "CMDECHO" oldEcho))
    (if oldLyr (setvar "CLAYER" oldLyr))
    (if oldDimScale (setvar "DIMSCALE" oldDimScale))
    (if doc (vla-EndUndoMark doc) (command "_.UNDO" "_End"))
    (if (and msg (not (wcmatch (strcase msg t) "*break*,*cancel*,*exit*")))
      (princ (strcat "\nError: " msg))
    )
    (princ)
  )

  ;; Validate geometry
  (setq rM (/ dMain 2.0))
  (setq rBo (/ dBranch 2.0))
  (setq rBi (- rBo thk))
  (if (or (<= dMain 0.0) (<= dBranch 0.0) (<= thk 0.0) (>= rBo rM) (<= rBi 0.0) (<= hDist rM))
    (progn
      (princ "\n[ERROR] Invalid pipe dimensions! Ensure D_branch < D_main, t < D_branch/2, and H > D_main/2.")
      (exit)
    )
  )

  (setq acadObj (vl-catch-all-apply 'vlax-get-acad-object nil))
  (if (and acadObj (not (vl-catch-all-error-p acadObj)))
    (progn
      (setq doc (vl-catch-all-apply 'vla-get-ActiveDocument (list acadObj)))
      (if (vl-catch-all-error-p doc) (setq doc nil))
      (if doc
        (progn
          (setq sp (vl-catch-all-apply 'vla-get-ModelSpace (list doc)))
          (if (vl-catch-all-error-p sp) (setq sp nil))
          (vla-StartUndoMark doc)
        )
      )
    )
  )

  (setq oldOsm (getvar "OSMODE"))
  (setq oldEcho (getvar "CMDECHO"))
  (setq oldLyr (getvar "CLAYER"))
  (setq oldDimScale (getvar "DIMSCALE"))
  (setvar "CMDECHO" 0)
  (setvar "OSMODE" 0)
  (if (null doc) (command "_.UNDO" "_Begin"))

  (setq bx (float (car pt)) by (float (cadr pt)))

  ;; Ensure standard layers
  (gj-ensure-layer "0" 7)
  (gj-ensure-layer "PL" 3)
  (gj-ensure-layer "CL" 1)
  (gj-ensure-layer "HL" 4)
  (gj-ensure-layer "PLOT_BOX" 4)
  (gj-ensure-layer "DIMENSIONS" 3)
  (gj-ensure-layer "AI_MOD_BOX" 3)

  ;; Compute mathematical parameters (1:1 actual mm)
  (setq wDev (* pi (- dBranch thk)))
  (setq yInt (sqrt (- (* rM rM) (* rBi rBi))))
  (setq lMin (- hDist rM))
  (setq lMax (- hDist yInt))
  (setq todayStr (gj-today-str))

  (if (< nParts 1) (setq nParts 1))
  (setq pieceW (/ wDev (float nParts)))
  (setq seamRad (* (float seamDeg) (/ pi 180.0)))
  (setq gapY (+ lMax 450.0))
  (setq totalDevH (+ (* nParts lMax) (* (1- nParts) 450.0)))

  ;; Auto-compute form split ratio and form scale (base form 2970 x 4200, base DIMSCALE = 10)
  (setq needLW (+ dMain 650.0))
  (setq needLH (+ rM hDist 650.0))
  (setq needRW (+ pieceW 650.0))
  (setq needRH (+ totalDevH 650.0))
  (setq splitRatio (max 0.28 (min 0.50 (/ needLW (+ needLW needRW)))))

  (if (and formScaleIn (> formScaleIn 0.0))
    (setq formScale (float formScaleIn))
    (progn
      (setq reqScale (max 1.0
                          (/ needLW (* 2970.0 splitRatio))
                          (/ needRW (* 2970.0 (- 1.0 splitRatio)))
                          (/ (max needLH needRH) 3350.0)))
      ;; Round up to nearest 0.5 step
      (setq formScale (* 0.5 (fix (+ (/ reqScale 0.5) 0.9999))))
    )
  )
  (setq formW (* 2970.0 formScale))
  (setq formH (* 4200.0 formScale))
  (setq splitX (+ bx (* formW splitRatio)))
  (setq dimScale (* 10.0 formScale))
  (setvar "DIMSCALE" dimScale)

  ;; 1. Scaled Dooshin CP Form Geometry
  (gj-add-line (list bx (+ by (* 4941.4030 formScale))) (list (+ bx (* 1013.0464 formScale)) (+ by (* 4941.4030 formScale))) "PL" 256)
  (gj-add-line (list bx (+ by (* 4768.2001 formScale))) (list (+ bx (* 1013.0464 formScale)) (+ by (* 4768.2001 formScale))) "CL" 256)
  (gj-add-line (list bx (+ by (* 4422.8902 formScale))) (list (+ bx (* 1013.0464 formScale)) (+ by (* 4422.8902 formScale))) "HL" 256)

  ;; Outer Frame (0 layer) and Plot Box (PLOT_BOX layer)
  (gj-add-pline (list (list bx by) (list (+ bx formW) by) (list (+ bx formW) (+ by formH)) (list bx (+ by formH))) T "0" 256)
  (gj-add-pline (list (list bx by) (list (+ bx formW) by) (list (+ bx formW) (+ by formH)) (list bx (+ by formH))) T "PLOT_BOX" 256)

  ;; Adjustable Divider Line
  (gj-add-line (list splitX (+ by (* 3950.0 formScale))) (list splitX by) "PL" 256)

  ;; 2. Scaled Title Block Texts
  (gj-add-text (strcat "CUSTOMER: " cust) (+ bx (* 50.0 formScale)) (+ by (* 4050.0 formScale)) (* 50.0 formScale) 0.7 0.139626 256 "0")
  (gj-add-text (strcat "PROJECT: " proj) (+ bx (* 50.0 formScale)) (+ by (* 3950.0 formScale)) (* 50.0 formScale) 0.7 0.139626 256 "0")
  (gj-add-text (strcat "DWG NO.: " dwgno) (+ bx (* 50.0 formScale)) (+ by (* 3750.0 formScale)) (* 50.0 formScale) 0.7 0.139626 256 "0")

  (setq bomStr (strcat "1. PL " (rtos thk 2 1) "tx" (rtos lMax 2 1) "x" (rtos pieceW 2 1) "-" (itoa qty) "EA (가지관 OD " (rtos dBranch 2 1) ", 분할각도 " (rtos seamDeg 2 1) "도)"))
  (gj-add-text bomStr (+ bx (* 50.0 formScale)) (+ by (* 3648.5469 formScale)) (* 45.0 formScale) 0.6 0.139626 256 "0")
  (gj-add-text (strcat "2. MAIN PIPE OD " (rtos dMain 2 1) " / H=" (rtos hDist 2 1) " (SCALE 1:1, DIMSCALE=" (rtos dimScale 2 0) ")")
               (+ bx (* 50.0 formScale)) (+ by (* 3548.5469 formScale)) (* 45.0 formScale) 0.6 0.139626 256 "0")

  (gj-add-text (strcat "NO. " pageStr) (+ bx (* 2470.0 formScale)) (+ by (* 4000.0 formScale)) (* 50.0 formScale) 0.7 0.139626 256 "0")
  (gj-add-text todayStr (+ bx (* 2470.0 formScale)) (+ by (* 3900.0 formScale)) (* 50.0 formScale) 0.7 0.139626 256 "0")
  (gj-add-text (strcat "수량 x" (itoa qty)) (+ bx (* 1085.0 formScale)) (+ by (* 3950.0 formScale)) (* 200.0 formScale) 0.7 0.139626 256 "0")

  ;; 3. Scaled Dooshin Logo Solid Hatch Helper
  (defun make-hatch-loop ( pts col rgb / ent plObj hObj outerLoop tCol )
    (setq ent
      (entmakex
        (append
          (list
            '(0 . "LWPOLYLINE")
            '(100 . "AcDbEntity")
            '(8 . "0")
            (if rgb
              (cons 420 (+ (* (car rgb) 65536) (* (cadr rgb) 256) (caddr rgb)))
              (cons 62 col)
            )
            '(100 . "AcDbPolyline")
            (cons 90 (length pts))
            '(70 . 1)
          )
          (mapcar '(lambda (p) (cons 10 (list (+ bx (* (car p) formScale)) (+ by (* (cadr p) formScale))))) pts)
        )
      )
    )
    (if (and ent sp)
      (progn
        (setq plObj (vlax-ename->vla-object ent))
        (setq hObj (vla-AddHatch sp 1 "SOLID" :vlax-false))
        (if rgb
          (progn
            (setq tCol (vla-get-TrueColor hObj))
            (vla-SetRGB tCol (car rgb) (cadr rgb) (caddr rgb))
            (vla-put-TrueColor hObj tCol)
          )
          (vla-put-color hObj col)
        )
        (setq outerLoop (vlax-make-safearray vlax-vbObject '(0 . 0)))
        (vlax-safearray-fill outerLoop (list plObj))
        (vla-AppendOuterLoop hObj outerLoop)
        (vla-Evaluate hObj)
        (vla-delete plObj)
      )
    )
  )

