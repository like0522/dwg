(defun c:ClearAICP ( / doc ss i cnt )
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (vla-StartUndoMark doc)
  (setq cnt 0)
  (setq ss (ssget "X" '((8 . "AI_CP"))))
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (entdel (ssname ss i))
        (setq cnt (1+ cnt))
        (setq i (1+ i))
      )
      (setq ss nil)
    )
  )
  (vla-EndUndoMark doc)
  (princ (strcat "\n[ClearAICP] Removed " (itoa cnt) " AI_CP entities."))
  (princ)
)

