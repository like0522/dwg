(vl-load-com)

(defun *error* (msg / doc)
  (if (and msg (not (wcmatch (strcase msg) "*BREAK*,*CANCEL*,*EXIT*")))
    (princ (strcat "\n[ERROR] " msg))
  )
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (if doc (vla-EndUndoMark doc))
  (princ)
)

(defun _ensure-aicp-layer (doc / layers lay)
  (setq layers (vla-get-Layers doc))
  (if (not (tblsearch "LAYER" "AI_CP"))
    (progn
      (setq lay (vla-Add layers "AI_CP"))
      (vla-put-Color lay 3)
    )
    (vla-put-Color (vla-Item layers "AI_CP") 3)
  )
)

(defun _draw-sheet-frame (x0 ytop w h / x1 y1 xmid)
  (setq x1 (+ x0 w))
  (setq y1 (- ytop h))
  (setq xmid (+ x0 (/ w 2.0)))
  (entmakex
    (list
      '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "AI_CP") '(62 . 3)
      '(100 . "AcDbPolyline") '(90 . 4) '(70 . 1)
      (cons 10 (list x0 y1))
      (cons 10 (list x1 y1))
      (cons 10 (list x1 ytop))
      (cons 10 (list x0 ytop))
    )
  )
  (entmakex
    (list
      '(0 . "LINE") '(100 . "AcDbEntity") '(8 . "AI_CP") '(62 . 8)
      '(100 . "AcDbLine")
      (cons 10 (list xmid ytop 0.0))
      (cons 11 (list xmid y1 0.0))
    )
  )
)

(defun _add-text (x y h txt)
  (entmakex
    (list
      '(0 . "TEXT") '(100 . "AcDbEntity") '(8 . "AI_CP") '(62 . 7)
      '(100 . "AcDbText")
      (cons 10 (list x y 0.0))
      (cons 40 h)
      (cons 1 txt)
    )
  )
)

(defun _draw-rect (x y w h)
  (entmakex
    (list
      '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "AI_CP") '(62 . 4)
      '(100 . "AcDbPolyline") '(90 . 4) '(70 . 1)
      (cons 10 (list x y))
      (cons 10 (list (+ x w) y))
      (cons 10 (list (+ x w) (+ y h)))
      (cons 10 (list x (+ y h)))
    )
  )
)

(defun _draw-circle (cx cy r)
  (entmakex
    (list
      '(0 . "CIRCLE") '(100 . "AcDbEntity") '(8 . "AI_CP") '(62 . 4)
      '(100 . "AcDbCircle")
      (cons 10 (list cx cy 0.0))
      (cons 40 r)
    )
  )
)

