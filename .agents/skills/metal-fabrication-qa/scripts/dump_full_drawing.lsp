;; Fast CAD Entity Dumper for Fabrication Inspection
;; Dumps TEXT, MTEXT, DIMENSION, LINE, CIRCLE, ARC, LWPOLYLINE

(defun c:DumpFullDrawing ( / f ss i ent ed typ lay p1 p2 p3 val str h rad )
  (setq f (open "C:/Users/like/scpi_engine/brain/cache/lisp_dump.txt" "w"))
  (if f
    (progn
      (write-line "=== TEXTS ===" f)
      (setq ss (ssget "X" '((0 . "TEXT,MTEXT"))))
      (if ss
        (progn
          (setq i 0)
          (while (< i (sslength ss))
            (setq ent (ssname ss i))
            (setq ed (entget ent))
            (setq str (cdr (assoc 1 ed)))
            (setq p1 (cdr (assoc 10 ed)))
            (setq lay (cdr (assoc 8 ed)))
            (setq h (cdr (assoc 40 ed)))
            (setq typ (cdr (assoc 0 ed)))
            (if (and str p1)
              (write-line (strcat typ "\t" (rtos (car p1) 2 2) "\t" (rtos (cadr p1) 2 2) "\t" (rtos (caddr p1) 2 2) "\t" (if h (rtos h 2 2) "0") "\t" lay "\t" str) f)
            )
            (setq i (1+ i))
          )
        )
      )

      (write-line "=== DIMS ===" f)
      (setq ss (ssget "X" '((0 . "DIMENSION"))))
      (if ss
        (progn
          (setq i 0)
          (while (< i (sslength ss))
            (setq ent (ssname ss i))
            (setq ed (entget ent))
            (setq val (cdr (assoc 42 ed)))
            (setq str (cdr (assoc 1 ed)))
            (setq p1 (cdr (assoc 10 ed)))
            (setq p2 (cdr (assoc 11 ed)))
            (setq p3 (cdr (assoc 13 ed)))
            (setq lay (cdr (assoc 8 ed)))
            (if (and val p1)
              (write-line (strcat (rtos (car p1) 2 2) "\t" (rtos (cadr p1) 2 2) "\t" (rtos val 2 2) "\t" (if str str "") "\t" lay "\t" (if p2 (strcat (rtos (car p2) 2 2) "," (rtos (cadr p2) 2 2)) "") "\t" (if p3 (strcat (rtos (car p3) 2 2) "," (rtos (cadr p3) 2 2)) "")) f)
            )
            (setq i (1+ i))
          )
        )
      )

      (write-line "=== GEOM ===" f)
      (setq ss (ssget "X" '((0 . "LINE,CIRCLE,ARC,LWPOLYLINE"))))
      (if ss
        (progn
          (setq i 0)
          (while (< i (sslength ss))
            (setq ent (ssname ss i))
            (setq ed (entget ent))
            (setq typ (cdr (assoc 0 ed)))
            (setq lay (cdr (assoc 8 ed)))
            (cond
              ((= typ "LINE")
               (setq p1 (cdr (assoc 10 ed)))
               (setq p2 (cdr (assoc 11 ed)))
               (if (and p1 p2)
                 (write-line (strcat "LINE\t" lay "\t" (rtos (car p1) 2 2) "\t" (rtos (cadr p1) 2 2) "\t" (rtos (car p2) 2 2) "\t" (rtos (cadr p2) 2 2)) f)
               ))
              ((= typ "CIRCLE")
               (setq p1 (cdr (assoc 10 ed)))
               (setq rad (cdr (assoc 40 ed)))
               (if (and p1 rad)
                 (write-line (strcat "CIRCLE\t" lay "\t" (rtos (car p1) 2 2) "\t" (rtos (cadr p1) 2 2) "\t" (rtos rad 2 2)) f)
               ))
              ((= typ "ARC")
               (setq p1 (cdr (assoc 10 ed)))
               (setq rad (cdr (assoc 40 ed)))
               (if (and p1 rad)
                 (write-line (strcat "ARC\t" lay "\t" (rtos (car p1) 2 2) "\t" (rtos (cadr p1) 2 2) "\t" (rtos rad 2 2)) f)
               ))
              ((= typ "LWPOLYLINE")
               (setq p1 (cdr (assoc 10 ed)))
               (if p1
                 (write-line (strcat "LWPOLYLINE\t" lay "\t" (rtos (car p1) 2 2) "\t" (rtos (cadr p1) 2 2)) f)
               ))
            )
            (setq i (1+ i))
          )
        )
      )

      (close f)
      (princ "\nFULL DUMP COMPLETE!")
    )
  )
  (princ)
)
(c:DumpFullDrawing)
